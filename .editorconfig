root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Shell 脚本：tab 缩进（shfmt 默认）
[*.sh]
indent_style = tab
indent_size = 4

[Dockerfile*]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2

[justfile]
indent_style = space
indent_size = 4
